#: packerform.pas:1159
msgid "%d Songs gefunden, %d bereit zum Packen."
msgstr "%d brani trovati, %d pronti da impacchettare."

#: packerform.pas:1414
msgid "%d Stem-Dateien erstellt, %d Fehler, %d übersprungen."
msgstr "%d file stem creati, %d errori, %d saltati."

#: packerform.pas:1404
msgid "%d fertig, %d Fehler, %d übersprungen."
msgstr "%d completati, %d errori, %d saltati."

#: packerform.pas:1217
msgid "%s ist %s s kürzer als %s"
msgstr "%s è più corto di %s s rispetto a %s"

#: packerform.pas:1220
msgid "%s ist %s s länger als %s"
msgstr "%s è più lungo di %s s rispetto a %s"

#: packerform.pas:1104
msgid "%s „%s“"
msgstr "%s «%s»"

#: packerform.pas:368
msgid "(Tags und Cover)"
msgstr "(tag e copertina)"

#: packerform.pas:583
msgid "24 Bit / 96 kHz ist noch nicht in Traktor geprüft. Bitte zuerst mit einem Song testen."
msgstr "24 bit / 96 kHz non è ancora stato provato in Traktor. Prova prima con un solo brano."

#: packerform.pas:491
msgid "5.1-DVD: „Song (DOWNMIX #1)“ + „Song (A)“ … „(D)“"
msgstr "DVD 5.1: «Song (DOWNMIX #1)» + «Song (A)» … «(D)»"

#: packerform.pas:580
msgid "AAC 320 kbit/s (wie Traktor-Stems)"
msgstr "AAC 320 kbit/s (come gli stem di Traktor)"

#: packerform.pas:582
msgid "ALAC 24 Bit, Original-Abtastrate (Test)"
msgstr "ALAC 24 bit, frequenza originale (test)"

#: packerform.pas:581
msgid "ALAC verlustfrei, 16 Bit / 44,1 kHz"
msgstr "ALAC senza perdita, 16 bit / 44,1 kHz"

#: packerform.pas:652
msgid "Abbrechen"
msgstr "Annulla"

#: packerform.pas:643
msgid "Alle packen"
msgstr "Impacchetta tutto"

#: packerform.pas:501
msgid "Auch in Unterordnern suchen. Die Unterordner müssen in allen Ordnern gleich heissen."
msgstr "Cerca anche nelle sottocartelle. Le sottocartelle devono avere lo stesso nome in tutte le cartelle."

#: packerform.pas:565
msgid "Ausgabeordner (Unterordner werden übernommen)"
msgstr "Cartella di destinazione (le sottocartelle vengono mantenute)"

#: packerform.pas:1666
msgid "Ausgabeordner wählen"
msgstr "Scegli la cartella di destinazione"

#: packerform.pas:380
msgid "Beispiel: „* (A)“ findet „Hello (A).wav“, der Song heisst dann „Hello“."
msgstr "Esempio: «* (A)» trova «Hello (A).wav», il brano si chiamerà quindi «Hello»."

#: packerform.pas:1046
msgid "Bitte einen Ausgabeordner angeben (oder „neben die Master-Datei“ wählen)."
msgstr "Indica una cartella di destinazione (oppure scegli «accanto al file master»)."

#: packerform.pas:1495
msgid "Bitte im nächsten Fenster die ffmpeg.exe auswählen (z. B. aus StemMaker\\tools\\)."
msgstr "Seleziona ffmpeg.exe nella finestra successiva (ad es. da StemMaker\\tools\\)."

#: packerform.pas:1716 packerform.pas:1802
msgid "Breche ab ..."
msgstr "Annullamento ..."

#: packerform.pas:598
msgid "Cover aus dem Ordner, wenn die Datei keins hat"
msgstr "Copertina dalla cartella se il file non ne ha"

#: packerform.pas:492
msgid "DAW-Export: „Song“ + „Song_drums“ … „_vocals“"
msgstr "Esportazione DAW: «Song» + «Song_drums» … «_vocals»"

#: packerform.pas:1736
msgid "Danke an Cuiusquemodi für die Idee, den Test mit 178 Songs und die vielen Rückmeldungen."
msgstr "Grazie a Cuiusquemodi per l’idea, il test con 178 brani e i tanti riscontri."

#: packerform.pas:682
msgid "Dateien"
msgstr "File"

#: packerform.pas:379
msgid "Dateiname ohne Endung, * steht für den Songnamen."
msgstr "Nome del file senza estensione, * sta per il nome del brano."

#: packerform.pas:1041
msgid "Der Ordner von „%s“ fehlt oder existiert nicht."
msgstr "La cartella di «%s» manca o non esiste."

#: packerform.pas:474
msgid "Die Benennung wird erkannt, z. B. „Song_drums“, „Song (Vocals)“, „Song (A)“ oder „Song_1“."
msgstr "I nomi vengono riconosciuti da soli, ad es. «Song_drums», «Song (Vocals)», «Song (A)» o «Song_1»."

#: packerform.pas:1416
msgid "Die Dateien lassen sich direkt in Traktor laden. Ordner jetzt öffnen?"
msgstr "I file si possono caricare direttamente in Traktor. Aprire la cartella adesso?"

#: packerform.pas:494
msgid "Eigene Muster"
msgstr "Modelli personalizzati"

#: packerform.pas:857
msgid "Erkannt: „%s“ … „%s“, %s."
msgstr "Riconosciuto: «%s» … «%s», %s."

#: packerform.pas:594
msgid "Extras:"
msgstr "Extra:"

#: packerform.pas:511
msgid "Farbe"
msgstr "Colore"

#: packerform.pas:348
msgid "Farbe des Stems in Traktor (klicken zum Ändern)"
msgstr "Colore dello stem in Traktor (clicca per cambiare)"

#: packerform.pas:595
msgid "Fehlende Stems still füllen"
msgstr "Riempi gli stem mancanti con silenzio"

#: packerform.pas:1335
msgid "Fehler: Datei konnte nicht gespeichert werden"
msgstr "Errore: impossibile salvare il file"

#: packerform.pas:1329
msgid "Fehler: Ergebnis hat nicht 5 Spuren"
msgstr "Errore: il risultato non ha 5 tracce"

#: packerform.pas:1323
msgid "Fehler: Stem-Block"
msgstr "Errore: blocco stem"

#: packerform.pas:1310
msgid "Fehler: ffmpeg Code %d (siehe Log)"
msgstr "Errore: ffmpeg codice %d (vedi log)"

#: packerform.pas:596
msgid "Fehlt ein Stem, wird eine stille Spur eingesetzt, statt den Song zu überspringen."
msgstr "Se manca uno stem, viene usata una traccia silenziosa invece di saltare il brano."

#: packerform.pas:572
msgid "Format:"
msgstr "Formato:"

#: packerform.pas:1738
msgid "Frei unter der MIT-Lizenz. Enthält ffmpeg (LGPL)."
msgstr "Libero con licenza MIT. Include ffmpeg (LGPL)."

#: packerform.pas:471
msgid "Für Benennungen, die nicht erkannt werden: Ordner, Namensmuster, Stem-Namen und Farben je Spur selbst eintragen."
msgstr "Per nomi non riconosciuti: inserisci tu cartella, modello di nome, nome dello stem e colore di ogni traccia."

#: packerform.pas:497
msgid "Für Spuren ohne fertigen Master: die vier Stems werden ohne Pegeländerung zusammengemischt."
msgstr "Per tracce senza master: i quattro stem vengono mixati insieme senza cambiare il livello."

#: packerform.pas:599
msgid "Hat die Master-Datei kein Cover, wird cover.jpg, folder.jpg, front.jpg oder <Song>.jpg aus ihrem Ordner genommen."
msgstr "Se il file master non ha copertina, viene usato cover.jpg, folder.jpg, front.jpg o <brano>.jpg dalla sua cartella."

#: packerform.pas:1035
msgid "Im Muster von „%s“ fehlt der Stern * für den Songnamen."
msgstr "Nel modello di «%s» manca l’asterisco * per il nome del brano."

#: packerform.pas:667
msgid "Info"
msgstr "Info"

#: packerform.pas:610 packerform.pas:1753
msgid "Kaffee spendieren"
msgstr "Offrimi un caffè"

#: packerform.pas:1157
msgid "Keine Songs gefunden. Ordner und Muster prüfen (Stern * = Songname)."
msgstr "Nessun brano trovato. Controlla cartelle e modelli (asterisco * = nome del brano)."

#: packerform.pas:799
msgid "Keine bekannte Benennung gefunden. Bitte Ordner und Muster selbst einstellen."
msgstr "Nessun nome conosciuto trovato. Imposta tu cartelle e modelli."

#: packerform.pas:660
msgid "Log anzeigen"
msgstr "Mostra log"

#: packerform.pas:1198
msgid "Längen prüfen"
msgstr "Controllo durate"

#: packerform.pas:1413
msgid "Längen-Warnung bei %d Song(s): eine Spur ist kürzer oder länger als der Rest (siehe Liste). Bitte in Traktor anhören, ob alles zusammenpasst."
msgstr "Avviso di durata per %d brano/i: una traccia è più corta o più lunga delle altre (vedi elenco). Ascolta in Traktor se tutto è a tempo."

#: packerform.pas:312
msgid "Master"
msgstr "Master"

#: packerform.pas:853
msgid "Master aus den Stems gemischt"
msgstr "master mixato dagli stem"

#: packerform.pas:496
msgid "Master aus den Stems mischen"
msgstr "Mixa il master dagli stem"

#: packerform.pas:855
msgid "Master „%s“"
msgstr "master «%s»"

#: packerform.pas:359
msgid "Name des Stems, so zeigt ihn Traktor an"
msgstr "Nome dello stem, come lo mostra Traktor"

#: packerform.pas:515
msgid "Namensmuster (* = Songname)"
msgstr "Modello di nome (* = nome del brano)"

#: packerform.pas:493
msgid "Nummern: „Song_0“ (Master) bis „Song_4“"
msgstr "Numeri: «Song_0» (master) fino a «Song_4»"

#: packerform.pas:517
msgid "Ordner"
msgstr "Cartella"

#: packerform.pas:400
msgid "Ordner mit den Master-Dateien"
msgstr "Cartella con i file master"

#: packerform.pas:464
msgid "Ordner mit den Spuren hier hineinziehen"
msgstr "Trascina qui la cartella con le tracce"

#: packerform.pas:252
msgid "Ordner mit den Spuren hineinziehen oder „Ordner wählen …“ klicken."
msgstr "Trascina la cartella con le tracce oppure clicca su «Scegli cartella …»."

#: packerform.pas:1624
msgid "Ordner mit den Spuren wählen"
msgstr "Scegli la cartella con le tracce"

#: packerform.pas:721
msgid "Ordner mit den Stems"
msgstr "Cartella con gli stem"

#: packerform.pas:250
msgid "Ordner und Muster einstellen, dann „Songs suchen“."
msgstr "Imposta cartelle e modelli, poi «Cerca brani»."

#: packerform.pas:468
msgid "Ordner und Muster selbst einstellen"
msgstr "Imposta cartelle e modelli a mano"

#: packerform.pas:392 packerform.pas:1649
msgid "Ordner wählen"
msgstr "Scegli cartella"

#: packerform.pas:461
msgid "Ordner wählen …"
msgstr "Scegli cartella …"

#: packerform.pas:1300
msgid "Packe %s"
msgstr "Impacchetto %s"

#: packerform.pas:1734
msgid "Packt fertige Einzelspuren (Master und 4 Stems) ohne KI-Trennung zu Traktor-Stem-Dateien."
msgstr "Impacchetta tracce singole già pronte (master e 4 stem) in file stem di Traktor, senza separazione IA."

#: packerform.pas:681
msgid "Song"
msgstr "Brano"

#: packerform.pas:1390
msgid "Song %d von %d: %s"
msgstr "Brano %d di %d: %s"

#: packerform.pas:635
msgid "Songs suchen"
msgstr "Cerca brani"

#: packerform.pas:586
msgid "Sonst werden Songs übersprungen, deren Stem-Datei es schon gibt."
msgstr "Altrimenti i brani il cui file stem esiste già vengono saltati."

#: packerform.pas:510
msgid "Spur"
msgstr "Traccia"

#: packerform.pas:683
msgid "Status"
msgstr "Stato"

#: packerform.pas:313
msgid "Stem %d"
msgstr "Stem %d"

#: packerform.pas:513
msgid "Stem-Name"
msgstr "Nome stem"

#: packerform.pas:1268
msgid "Tags lesen"
msgstr "Lettura tag"

#: packerform.pas:500
msgid "Unterordner durchsuchen"
msgstr "Cerca nelle sottocartelle"

#: packerform.pas:585
msgid "Vorhandene überschreiben"
msgstr "Sovrascrivi esistenti"

#: packerform.pas:485
msgid "Vorlage:"
msgstr "Modello:"

#: packerform.pas:684
msgid "Ziel"
msgstr "Destinazione"

#: packerform.pas:535
msgid "Ziel:"
msgstr "Destinazione:"

#: packerform.pas:1304
msgid "abgebrochen"
msgstr "annullato"

#: packerform.pas:1147
msgid "bereit"
msgstr "pronto"

#: packerform.pas:1145
msgid "bereit, still gefüllt: "
msgstr "pronto, riempito con silenzio: "

#: packerform.pas:1210
msgid "der Master"
msgstr "il master"

#: packerform.pas:1210
msgid "die längste Spur"
msgstr "la traccia più lunga"

#: packerform.pas:1139
msgid "fehlt: "
msgstr "manca: "

#: packerform.pas:1345
msgid "fertig"
msgstr "completato"

#: packerform.pas:1341
msgid "fertig, Achtung: "
msgstr "completato, attenzione: "

#: packerform.pas:230
msgid "fertige Spuren zu Stem-Dateien packen"
msgstr "impacchettare tracce pronte in file stem"

#: packerform.pas:248
msgid "ffmpeg.exe nicht gefunden - wird beim ersten Gebrauch abgefragt."
msgstr "ffmpeg.exe non trovato - verrà richiesto al primo utilizzo."

#: packerform.pas:1494
msgid "ffmpeg.exe wurde nicht gefunden."
msgstr "ffmpeg.exe non è stato trovato."

#: packerform.pas:1141
msgid "gibt es schon, wird übersprungen"
msgstr "esiste già, verrà saltato"

#: packerform.pas:552
msgid "in diesen Ordner:"
msgstr "in questa cartella:"

#: packerform.pas:402 packerform.pas:723
msgid "leer = wie Master"
msgstr "vuoto = come il master"

#: packerform.pas:404
msgid "leer = wie Stem %d"
msgstr "vuoto = come lo stem %d"

#: packerform.pas:542
msgid "neben die Master-Datei"
msgstr "accanto al file master"

#: packerform.pas:1298
msgid "wird gepackt ..."
msgstr "in corso ..."

