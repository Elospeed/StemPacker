#: packerform.pas:1152
msgid "%d Songs gefunden, %d bereit zum Packen."
msgstr "%d nummers gevonden, %d klaar om te verpakken."

#: packerform.pas:1407
msgid "%d Stem-Dateien erstellt, %d Fehler, %d übersprungen."
msgstr "%d stem-bestanden gemaakt, %d fouten, %d overgeslagen."

#: packerform.pas:1397
msgid "%d fertig, %d Fehler, %d übersprungen."
msgstr "%d klaar, %d fouten, %d overgeslagen."

#: packerform.pas:1210
msgid "%s ist %s s kürzer als %s"
msgstr "%s is %s s korter dan %s"

#: packerform.pas:1213
msgid "%s ist %s s länger als %s"
msgstr "%s is %s s langer dan %s"

#: packerform.pas:1097
msgid "%s „%s“"
msgstr "%s ‘%s’"

#: packerform.pas:367
msgid "(Tags und Cover)"
msgstr "(tags en hoes)"

#: packerform.pas:580
msgid "24 Bit / 96 kHz ist noch nicht in Traktor geprüft. Bitte zuerst mit einem Song testen."
msgstr "24 bit / 96 kHz is nog niet getest in Traktor. Probeer eerst één nummer."

#: packerform.pas:490
msgid "5.1-DVD: „Song (DOWNMIX #1)“ + „Song (A)“ … „(D)“"
msgstr "5.1-dvd: ‘Song (DOWNMIX #1)’ + ‘Song (A)’ … ‘(D)’"

#: packerform.pas:577
msgid "AAC 320 kbit/s (wie Traktor-Stems)"
msgstr "AAC 320 kbit/s (zoals Traktor-stems)"

#: packerform.pas:579
msgid "ALAC 24 Bit, Original-Abtastrate (Test)"
msgstr "ALAC 24 bit, originele samplefrequentie (test)"

#: packerform.pas:578
msgid "ALAC verlustfrei, 16 Bit / 44,1 kHz"
msgstr "ALAC verliesvrij, 16 bit / 44,1 kHz"

#: packerform.pas:648
msgid "Abbrechen"
msgstr "Annuleren"

#: packerform.pas:639
msgid "Alle packen"
msgstr "Alles verpakken"

#: packerform.pas:500
msgid "Auch in Unterordnern suchen. Die Unterordner müssen in allen Ordnern gleich heissen."
msgstr "Ook in submappen zoeken. De submappen moeten in alle mappen dezelfde naam hebben."

#: packerform.pas:563
msgid "Ausgabeordner (Unterordner werden übernommen)"
msgstr "Uitvoermap (submappen blijven behouden)"

#: packerform.pas:1659
msgid "Ausgabeordner wählen"
msgstr "Uitvoermap kiezen"

#: packerform.pas:379
msgid "Beispiel: „* (A)“ findet „Hello (A).wav“, der Song heisst dann „Hello“."
msgstr "Voorbeeld: ‘* (A)’ vindt ‘Hello (A).wav’, het nummer heet dan ‘Hello’."

#: packerform.pas:1039
msgid "Bitte einen Ausgabeordner angeben (oder „neben die Master-Datei“ wählen)."
msgstr "Geef een uitvoermap op (of kies ‘naast het masterbestand’)."

#: packerform.pas:1488
msgid "Bitte im nächsten Fenster die ffmpeg.exe auswählen (z. B. aus StemMaker\\tools\\)."
msgstr "Kies in het volgende venster ffmpeg.exe (bijv. uit StemMaker\\tools\\)."

#: packerform.pas:1709 packerform.pas:1795
msgid "Breche ab ..."
msgstr "Bezig met annuleren ..."

#: packerform.pas:594
msgid "Cover aus dem Ordner, wenn die Datei keins hat"
msgstr "Hoes uit de map als het bestand er geen heeft"

#: packerform.pas:491
msgid "DAW-Export: „Song“ + „Song_drums“ … „_vocals“"
msgstr "DAW-export: ‘Song’ + ‘Song_drums’ … ‘_vocals’"

#: packerform.pas:1729
msgid "Danke an Cuiusquemodi für die Idee, den Test mit 178 Songs und die vielen Rückmeldungen."
msgstr "Dank aan Cuiusquemodi voor het idee, de test met 178 nummers en de vele reacties."

#: packerform.pas:678
msgid "Dateien"
msgstr "Bestanden"

#: packerform.pas:378
msgid "Dateiname ohne Endung, * steht für den Songnamen."
msgstr "Bestandsnaam zonder extensie, * staat voor de naam van het nummer."

#: packerform.pas:1034
msgid "Der Ordner von „%s“ fehlt oder existiert nicht."
msgstr "De map van ‘%s’ ontbreekt of bestaat niet."

#: packerform.pas:473
msgid "Die Benennung wird erkannt, z. B. „Song_drums“, „Song (Vocals)“, „Song (A)“ oder „Song_1“."
msgstr "De naamgeving wordt herkend, bijv. ‘Song_drums’, ‘Song (Vocals)’, ‘Song (A)’ of ‘Song_1’."

#: packerform.pas:1409
msgid "Die Dateien lassen sich direkt in Traktor laden. Ordner jetzt öffnen?"
msgstr "De bestanden kun je direct in Traktor laden. Map nu openen?"

#: packerform.pas:493
msgid "Eigene Muster"
msgstr "Eigen patronen"

#: packerform.pas:850
msgid "Erkannt: „%s“ … „%s“, %s."
msgstr "Herkend: ‘%s’ … ‘%s’, %s."

#: packerform.pas:590
msgid "Extras:"
msgstr "Extra’s:"

#: packerform.pas:510
msgid "Farbe"
msgstr "Kleur"

#: packerform.pas:347
msgid "Farbe des Stems in Traktor (klicken zum Ändern)"
msgstr "Kleur van de stem in Traktor (klik om te wijzigen)"

#: packerform.pas:591
msgid "Fehlende Stems still füllen"
msgstr "Ontbrekende stems met stilte vullen"

#: packerform.pas:1328
msgid "Fehler: Datei konnte nicht gespeichert werden"
msgstr "Fout: bestand kon niet worden opgeslagen"

#: packerform.pas:1322
msgid "Fehler: Ergebnis hat nicht 5 Spuren"
msgstr "Fout: resultaat heeft geen 5 sporen"

#: packerform.pas:1316
msgid "Fehler: Stem-Block"
msgstr "Fout: stem-blok"

#: packerform.pas:1303
msgid "Fehler: ffmpeg Code %d (siehe Log)"
msgstr "Fout: ffmpeg code %d (zie log)"

#: packerform.pas:592
msgid "Fehlt ein Stem, wird eine stille Spur eingesetzt, statt den Song zu überspringen."
msgstr "Ontbreekt er een stem, dan wordt een stil spoor gebruikt in plaats van het nummer over te slaan."

#: packerform.pas:569
msgid "Format:"
msgstr "Formaat:"

#: packerform.pas:1731
msgid "Frei unter der MIT-Lizenz. Enthält ffmpeg (LGPL)."
msgstr "Vrij onder de MIT-licentie. Bevat ffmpeg (LGPL)."

#: packerform.pas:470
msgid "Für Benennungen, die nicht erkannt werden: Ordner, Namensmuster, Stem-Namen und Farben je Spur selbst eintragen."
msgstr "Voor naamgeving die niet wordt herkend: vul per spoor zelf map, naampatroon, stemnaam en kleur in."

#: packerform.pas:496
msgid "Für Spuren ohne fertigen Master: die vier Stems werden ohne Pegeländerung zusammengemischt."
msgstr "Voor sporen zonder kant-en-klare master: de vier stems worden zonder niveauwijziging samengemixt."

#: packerform.pas:595
msgid "Hat die Master-Datei kein Cover, wird cover.jpg, folder.jpg, front.jpg oder <Song>.jpg aus ihrem Ordner genommen."
msgstr "Heeft het masterbestand geen hoes, dan wordt cover.jpg, folder.jpg, front.jpg of <nummer>.jpg uit de map gebruikt."

#: packerform.pas:1028
msgid "Im Muster von „%s“ fehlt der Stern * für den Songnamen."
msgstr "In het patroon van ‘%s’ ontbreekt de ster * voor de naam van het nummer."

#: packerform.pas:663
msgid "Info"
msgstr "Info"

#: packerform.pas:606 packerform.pas:1746
msgid "Kaffee spendieren"
msgstr "Trakteer op koffie"

#: packerform.pas:1150
msgid "Keine Songs gefunden. Ordner und Muster prüfen (Stern * = Songname)."
msgstr "Geen nummers gevonden. Controleer mappen en patronen (ster * = naam van het nummer)."

#: packerform.pas:792
msgid "Keine bekannte Benennung gefunden. Bitte Ordner und Muster selbst einstellen."
msgstr "Geen bekende naamgeving gevonden. Stel mappen en patronen zelf in."

#: packerform.pas:656
msgid "Log anzeigen"
msgstr "Log tonen"

#: packerform.pas:1191
msgid "Längen prüfen"
msgstr "Lengtes controleren"

#: packerform.pas:1406
msgid "Längen-Warnung bei %d Song(s): eine Spur ist kürzer oder länger als der Rest (siehe Liste). Bitte in Traktor anhören, ob alles zusammenpasst."
msgstr "Lengtewaarschuwing bij %d nummer(s): een spoor is korter of langer dan de rest (zie lijst). Luister in Traktor of alles gelijk loopt."

#: packerform.pas:311
msgid "Master"
msgstr "Master"

#: packerform.pas:846
msgid "Master aus den Stems gemischt"
msgstr "master uit de stems gemixt"

#: packerform.pas:495
msgid "Master aus den Stems mischen"
msgstr "Master uit de stems mixen"

#: packerform.pas:848
msgid "Master „%s“"
msgstr "master ‘%s’"

#: packerform.pas:358
msgid "Name des Stems, so zeigt ihn Traktor an"
msgstr "Naam van de stem, zoals Traktor hem toont"

#: packerform.pas:514
msgid "Namensmuster (* = Songname)"
msgstr "Naampatroon (* = naam van het nummer)"

#: packerform.pas:492
msgid "Nummern: „Song_0“ (Master) bis „Song_4“"
msgstr "Nummers: ‘Song_0’ (master) tot ‘Song_4’"

#: packerform.pas:516
msgid "Ordner"
msgstr "Map"

#: packerform.pas:399
msgid "Ordner mit den Master-Dateien"
msgstr "Map met de masterbestanden"

#: packerform.pas:463
msgid "Ordner mit den Spuren hier hineinziehen"
msgstr "Sleep de map met je sporen hierheen"

#: packerform.pas:251
msgid "Ordner mit den Spuren hineinziehen oder „Ordner wählen …“ klicken."
msgstr "Sleep de map met je sporen hierheen of klik op ‘Map kiezen …’."

#: packerform.pas:1617
msgid "Ordner mit den Spuren wählen"
msgstr "Map met je sporen kiezen"

#: packerform.pas:717
msgid "Ordner mit den Stems"
msgstr "Map met de stems"

#: packerform.pas:249
msgid "Ordner und Muster einstellen, dann „Songs suchen“."
msgstr "Stel mappen en patronen in en kies dan ‘Nummers zoeken’."

#: packerform.pas:467
msgid "Ordner und Muster selbst einstellen"
msgstr "Mappen en patronen zelf instellen"

#: packerform.pas:391 packerform.pas:1642
msgid "Ordner wählen"
msgstr "Map kiezen"

#: packerform.pas:460
msgid "Ordner wählen …"
msgstr "Map kiezen …"

#: packerform.pas:1293
msgid "Packe %s"
msgstr "Bezig met %s"

#: packerform.pas:1727
msgid "Packt fertige Einzelspuren (Master und 4 Stems) ohne KI-Trennung zu Traktor-Stem-Dateien."
msgstr "Verpakt kant-en-klare losse sporen (master en 4 stems) zonder AI-scheiding tot Traktor-stembestanden."

#: packerform.pas:677
msgid "Song"
msgstr "Nummer"

#: packerform.pas:1383
msgid "Song %d von %d: %s"
msgstr "Nummer %d van %d: %s"

#: packerform.pas:631
msgid "Songs suchen"
msgstr "Nummers zoeken"

#: packerform.pas:583
msgid "Sonst werden Songs übersprungen, deren Stem-Datei es schon gibt."
msgstr "Anders worden nummers overgeslagen waarvan het stem-bestand al bestaat."

